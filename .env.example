# Values are deployment-local. This file contains no usable secrets.
VAULT_ORIGIN=https://vault.example.com
VAULT_LISTEN=127.0.0.1:8791
VAULT_MONGODB_DATABASE=grexie_vault
# Read the connection string (including credentials) from a protected file.
VAULT_MONGODB_URI_FILE=/run/secrets/vault_mongodb_uri
# Exactly 32 random bytes; never derived from a password or committed to Git.
VAULT_STORAGE_KEY_FILE=/run/secrets/vault_storage_key
# Enable only for an isolated, trusted MongoDB network with transport protection.
VAULT_MONGODB_ALLOW_PRIVATE_PLAINTEXT=false
# Exact ingress peer CIDRs only. The proxy must overwrite X-Real-IP.
# Empty disables forwarded-header trust; never use a shared client network.
VAULT_TRUSTED_PROXIES=
